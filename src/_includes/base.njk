<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ title }} — valentina</title>
<meta name="description" content="{{ description or 'Valentina — acrílico, patrón y animales a mitad de una historia. Ciudad de México.' }}">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Work+Sans:wght@400;500;600&family=Reddit+Mono:wght@400;500;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/assets/css/style.css">
</head>
<body>

<nav>
  <a href="/" class="logo"><img src="/assets/img/site/logo-signature.png" alt="valentina"></a>
  <div class="navlinks" id="navlinks">
    <a href="/" class="{{ 'active' if nav == 'inicio' }}">Inicio</a>
    <a href="/coleccion/" class="{{ 'active' if nav == 'coleccion' }}">Nueva Colección</a>
    <a href="/obra-original/" class="{{ 'active' if nav == 'obra-original' }}">Obra Original</a>
    <a href="/prints/" class="{{ 'active' if nav == 'prints' }}">Prints</a>
    <a href="/comisiones/" class="{{ 'active' if nav == 'comisiones' }}">Comisiones</a>
    <a href="https://instagram.com/valentina.studio___" target="_blank" class="cta">Instagram ↗</a>
  </div>
  <button class="navtoggle" id="navtoggle" aria-label="Abrir menú" aria-expanded="false">☰</button>
</nav>
<script>
  document.getElementById('navtoggle').addEventListener('click', function () {
    var nav = document.getElementById('navlinks');
    var open = nav.classList.toggle('open');
    this.setAttribute('aria-expanded', open ? 'true' : 'false');
    this.textContent = open ? '✕' : '☰';
  });
</script>

{{ content | safe }}

<footer>
  <div class="footer-top">
    <a href="/" class="logo"><img src="/assets/img/site/logo-signature.png" alt="valentina"></a>
    <div class="footer-links">
      <a href="/">Inicio</a>
      <a href="/coleccion/">Nueva Colección</a>
      <a href="/obra-original/">Obra Original</a>
      <a href="/prints/">Prints</a>
      <a href="/comisiones/">Comisiones</a>
      <a href="https://instagram.com/valentina.studio___" target="_blank">Instagram</a>
      <a href="https://pinterest.com" target="_blank">Pinterest</a>
    </div>
  </div>
  <div class="footer-bottom">
    <span>© {% currentYear %} Valentina · Ciudad de México</span>
    <span>@valentina.studio___</span>
  </div>
</footer>
<script src="https://identity.netlify.com/v1/netlify-identity-widget.js"></script>
<script>
  if (window.netlifyIdentity) {
    window.netlifyIdentity.on("init", user => {
      if (!user) {
        window.netlifyIdentity.on("login", () => {
          document.location.href = "/admin/";
        });
      }
    });
  }
</script>
</body>
</html>
