---
layout: base.njk
nav: obra-original
---
<section class="section" style="padding-top:60px;">
  <div style="display:grid;grid-template-columns:1.1fr 0.9fr;gap:60px;align-items:start;">
    <div class="photo" style="box-shadow:0 1px 3px rgba(58,42,30,0.08);">
      <img src="{{ imagen }}" alt="{{ titulo }}">
    </div>
    <div>
      <span class="label">{{ tecnica }}</span>
      <h1 class="display" style="font-size:2rem;margin:12px 0 6px;">{{ titulo }}</h1>
      <p style="color:#7a6a5a;margin:0 0 24px;">{{ tamano }}</p>

      <div style="font-size:1.02rem;line-height:1.7;color:#5a4a3c;margin-bottom:30px;">{{ content | safe }}</div>

      {% if estado == "vendido" %}
        <p class="status vendido" style="font-size:1.1rem;font-weight:600;margin-bottom:20px;">Vendido</p>
        <a href="/comisiones/" class="btn btn-outline">¿Te gustó? Pregunta por algo similar →</a>
      {% else %}
        <p style="font-size:1.6rem;font-weight:600;margin-bottom:24px;">${{ precio | currency }} MXN</p>
        <!-- Botón de compra: se conecta a un Payment Link de Stripe específico de esta pieza -->
{% if stripe_link %}
  <a href="{{ stripe_link }}" class="btn" target="_blank" rel="noopener">Comprar esta pieza →</a>
{% else %}
  <a href="/comisiones/" class="btn btn-outline">Pregúntame por esta pieza →</a>
{% endif %}
        <p class="field-hint" style="margin-top:14px;">Envío se cotiza aparte según tu ubicación. Recolección gratuita en CDMX.</p>
      {% endif %}
    </div>
  </div>
</section>
