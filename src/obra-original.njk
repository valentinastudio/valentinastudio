---
layout: base.njk
title: Obra Original
nav: obra-original
permalink: /obra-original/
---

<section class="section" style="padding-top:60px;">
  <div class="section-head">
    <div>
      <span class="label">Piezas únicas</span>
      <h2>Obra original</h2>
    </div>
  </div>
  <div class="gallery">
    {% for obra in collections.obras | reverse %}
    <a href="/obras/{{ obra.data.slug or obra.fileSlug }}/" class="piece-card">
      <div class="photo"><img src="{{ obra.data.imagen }}" alt="{{ obra.data.titulo }}"></div>
      <div class="caption">
        <div class="name">{{ obra.data.titulo }}</div>
        <div class="meta">
          <span>{{ obra.data.tamano }}</span>
          {% if obra.data.estado == "vendido" %}
            <span class="status vendido">Vendido</span>
          {% else %}
            <span class="price">${{ obra.data.precio | currency }} MXN</span>
          {% endif %}
        </div>
      </div>
    </a>
    {% endfor %}
  </div>
</section>
