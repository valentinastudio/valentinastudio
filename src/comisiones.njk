---
layout: base.njk
title: Comisiones
nav: comisiones
---

<section class="section" style="padding-top:60px;">
  <span class="label">Comisiones</span>
  <h1 class="display" style="font-size:2.2rem;margin:12px 0 24px;max-width:18ch;">Cuéntame tu idea y yo la convierto en arte.</h1>

  <div style="max-width:560px;margin-bottom:50px;">
    <p style="font-size:1.02rem;line-height:1.7;color:#5a4a3c;">Me especializo en pintar animales, patrones y cuadros coloridos. Si mi estilo hace sentido con la idea que tienes, me encantaría crear algo especial para ti.</p>
    <p style="font-size:1.02rem;line-height:1.7;color:#5a4a3c;">Llena el formulario y me pondré en contacto contigo para más detalles.</p>
  </div>

  <div class="form-wrap">
    <form name="comisiones" method="POST" data-netlify="true" netlify-honeypot="bot-field">
      <input type="hidden" name="form-name" value="comisiones">
      <p style="display:none;"><label>No llenar: <input name="bot-field"></label></p>

      <div class="field">
        <label for="nombre">Tu nombre</label>
        <input type="text" id="nombre" name="nombre" required>
      </div>

      <div class="field">
        <label for="email">Correo</label>
        <input type="email" id="email" name="email" required>
      </div>

      <div class="field">
        <label for="idea">Cuéntame tu idea</label>
        <textarea id="idea" name="idea" placeholder="La foto de referencia me la puedes mandar por correo o Instagram una vez que reciba tu mensaje. Aquí cuéntame el contexto o la historia detrás, si la hay." required></textarea>
      </div>

      <div class="field">
        <label for="tamano">Tamaño que tienes en mente</label>
        <select id="tamano" name="tamano">
          <option>Chico (hasta 40×40 cm)</option>
          <option>Mediano (40×60 a 70×70 cm)</option>
          <option>Grande (80×100 cm o más)</option>
          <option>No estoy segura, quiero que me orientes</option>
        </select>
      </div>

      <div class="field">
        <label for="presupuesto">Presupuesto aproximado (MXN)</label>
        <input type="text" id="presupuesto" name="presupuesto" placeholder="Ej. 8,000 - 12,000">
        <p class="field-hint">Como referencia, mis piezas de creación propia van de $5,700 a $28,500 MXN según tamaño — las comisiones llevan un 15-20% extra.</p>
      </div>

      <button type="submit" class="btn">Enviar →</button>
    </form>
  </div>
</section>

<script>
  // Solo interviene cuando se abre el archivo localmente (vista previa sin servidor).
  // En el sitio publicado de verdad (https://), el formulario funciona normal con Netlify Forms.
  if (location.protocol === "file:") {
    document.querySelector('form[name="comisiones"]').addEventListener("submit", function (e) {
      e.preventDefault();
      alert("Vista previa: este formulario se conecta de verdad en cuanto el sitio esté publicado.");
    });
  }
</script>
